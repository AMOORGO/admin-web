# Base URL of the AMOORGO API (no trailing slash, no /api/v1 suffix).
# Exposed to the browser (NEXT_PUBLIC_*) and inlined at build time. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend-less demo (build-time). "true" adds an "Explore demo (no backend)" button on the login screen that opens the
# console on built-in sample data; nothing is saved or sent. Leave "false" (or unset) when a real API is available.
NEXT_PUBLIC_DEMO_MODE=false
